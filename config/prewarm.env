# microVM 预热池配置（默认关闭）。由 control-plane-service.sh / prewarm worker
# 在启动前 source，字段语义见 docs/microVM预热池设计与实施方案.md。

# 总开关：0=关闭（默认），1=开启预热池。
PREWARM_ENABLED=0

# 池目标数量与未清理项上限。
PREWARM_TARGET_READY=1
PREWARM_MAX_TOTAL=2

# 后台补池与巡检。
PREWARM_BUILD_CONCURRENCY=1
PREWARM_TTL_SECONDS=900
PREWARM_HEALTH_INTERVAL_SECONDS=5

# 领取与激活超时（秒）。
PREWARM_CLAIM_TIMEOUT_SECONDS=30
PREWARM_ACTIVATE_TIMEOUT_SECONDS=10

# 补池前需保留的 Host 可用内存（MiB）。
PREWARM_MIN_AVAILABLE_MIB=2048
