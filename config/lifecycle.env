# Default idle timeout for normal instances: 5 minutes.
INSTANCE_IDLE_TIMEOUT_SECONDS=300

# Suspended instances are stopped after this second idle period: 10 minutes.
INSTANCE_SUSPENDED_STOP_TIMEOUT_SECONDS=600

# Regression tests stay fast even after the production default is increased.
LIFECYCLE_SMOKE_IDLE_TIMEOUT_SECONDS=6

# Auto-snapshot smoke test uses a short idle timeout to verify the two-phase lifecycle.
AUTO_SNAPSHOT_SMOKE_IDLE_TIMEOUT_SECONDS=8

# Second idle period for the auto-snapshot smoke test.
AUTO_SNAPSHOT_SMOKE_STOP_TIMEOUT_SECONDS=10
